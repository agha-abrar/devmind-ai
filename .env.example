####################################
# DevMind AI — Environment Config
# Copy to .env and fill in real values.
# Never commit the real .env file.
####################################

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ---------- Database (Postgres + pgvector) ----------
POSTGRES_USER=devmind
POSTGRES_PASSWORD=devmind_local_password
POSTGRES_DB=devmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devmind:devmind_local_password@postgres:5432/devmind
# Used by Alembic (sync driver) and scripts run outside docker
DATABASE_URL_SYNC=postgresql+psycopg2://devmind:devmind_local_password@localhost:5432/devmind

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- LLM Provider (OpenAI-compatible) ----------
# LLM_PROVIDER can be "openai" or "openai_compatible" (e.g. local vLLM/Ollama/OpenRouter gateway)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_REQUEST_TIMEOUT_SECONDS=60
# Optional, purely for cost display in Agent Run details — set to your provider's
# actual per-1M-token rates. Leave at 0 to hide cost estimates.
LLM_INPUT_PRICE_PER_1M_TOKENS=0
LLM_OUTPUT_PRICE_PER_1M_TOKENS=0

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536

# ---------- Reranking (optional) ----------
# If unset, the system falls back to a lexical/heuristic reranker (see rag/reranker.py)
RERANKER_PROVIDER=none
RERANKER_API_KEY=
RERANKER_MODEL=

# ---------- GitHub Integration ----------
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# Optional: personal access token fallback for public-repo ingestion without OAuth
GITHUB_DEFAULT_TOKEN=

# ---------- Uploads ----------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# ---------- Rate limiting ----------
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_INGESTION_PER_HOUR=20

# ---------- Seeding ----------
ENABLE_DEV_SEED=false

# ---------- Frontend (public, safe to expose) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
